{
  "version": 1,
  "updated": "2026-07-07",
  "paper_method_name": "IntentRoute",
  "implementation_identifier": "IntentWeight",
  "common_evidence_protocol": {
    "task_type": "evidence_retrieval",
    "top_k": 10,
    "backbone": "sentence-transformers/all-MiniLM-L6-v2",
    "baselines": [
      "bm25",
      "dense",
      "hybrid_rrf"
    ],
    "route_seeds": [13, 17, 19],
    "n_clusters": 32,
    "adaptation_epochs": 8,
    "route_evaluation": "eight_epoch_no_leakage_prequential_trajectory",
    "reporting_boundary": "repeated-query adaptation analysis; not IID held-out generalization",
    "feedback_modes": [
      "none",
      "trust_weighted"
    ],
    "budget_protocol": "five_fold_cross_fitted",
    "budget_grid": "task38_locked_grid",
    "budget_selection": "zero_observed_hit_drop_then_max_token_saving",
    "noninferiority_margin": 0.01,
    "metrics": [
      "hit@10",
      "evidence_recall@10",
      "mrr@10",
      "ndcg@10",
      "final_context_tokens",
      "dense_invocation_rate",
      "feedback_recovery_rate"
    ],
    "paired_statistics": [
      "paired_bootstrap_95ci",
      "exact_mcnemar",
      "query_level_win_loss_tie"
    ],
    "notes": [
      "Each query label updates only later interactions within the no-leakage prequential trajectory.",
      "Repeated eight-epoch trajectories are adaptation analyses and are not IID held-out generalization results.",
      "Hit@10 means at least one usable evidence chunk, not complete evidence collection.",
      "Final-context tokens are measured after evidence selection and before generation."
    ]
  },
